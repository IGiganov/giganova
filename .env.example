# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=1400
CLAUDE_MAX_TOOL_ROUNDS=2

# Budget & pricing (USD) — adjust as you scale
MONTHLY_BUDGET_USD=15.00
INPUT_PRICE_PER_MILLION=1.00
OUTPUT_PRICE_PER_MILLION=5.00
MAX_REQUESTS_PER_HOUR=30

# Market data limits
MAX_NEWS_ITEMS=8
MAX_TICKERS_PER_REQUEST=5
NEWS_SUMMARY_MAX_CHARS=200

# App
APP_HOST=127.0.0.1
APP_PORT=8000

# Ticker registry (SEC + NASDAQ + international listings; cached locally)
TICKER_REGISTRY_PATH=data/ticker_registry.json
INDEX_ALIASES_PATH=app/market/data/index_aliases.json
COMPANY_OVERRIDES_PATH=app/market/data/company_overrides.json
TICKER_REGISTRY_MAX_AGE_HOURS=168
TICKER_REGISTRY_REFRESH_ON_START=false
TICKER_REGISTRY_BACKGROUND_REFRESH=true
TICKER_REGISTRY_INCLUDE_INTERNATIONAL=true
TICKER_REGISTRY_USER_AGENT=GigaNova personal research (contact: you@example.com)

# Internal login (set AUTH_ENABLED=false to disable for local dev)
AUTH_ENABLED=true
# Accounts are stored (bcrypt-hashed) in this SQLite DB. On first run, the app
# sends you to /setup to create your account — no password needed here.
USERS_DB_PATH=data/users.sqlite3
AUTH_SECRET_KEY=generate-a-long-random-string-here
# Optional recovery admin: only active if BOTH a username and a password/hash are
# set. Lets you log in even if you forget your DB account. Leave blank to disable.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_PASSWORD=
